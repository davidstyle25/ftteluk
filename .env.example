# ============================================================================
# Contoh variabel lingkungan — salin ke Coolify (Environment Variables), JANGAN commit nilai asli.
# ============================================================================

# ---- BUILD VARIABLE (centang "Build Variable" di Coolify; ditanam ke bundle browser) ----
# URL publik Supabase (domain Kong / SERVICE_URL_SUPABASEKONG), mis. https://api.domainanda.com
VITE_SUPABASE_URL=https://api.domainanda.com
# Anon key (SERVICE_SUPABASEANON_KEY dari service Supabase di Coolify) — kunci PUBLIK
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon-key...
VITE_SUPABASE_PROJECT_ID=default

# ---- RUNTIME (server aplikasi; jangan centang Build Variable) ----
SUPABASE_URL=https://api.domainanda.com
SUPABASE_PUBLISHABLE_KEY=eyJ...anon-key...
# Service role key (SERVICE_SUPABASESERVICE_KEY) — RAHASIA, hanya untuk server (manajemen user)
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# Opsional
GOOGLE_SHEETS_API_KEY=
SHOW_ERROR_DETAILS=false
PORT=3000
